# Copia este fichero a deploy/.env y cambia los valores. deploy/.env nunca se sube al repositorio.
# Los nombres con doble guion bajo (__) son opciones de la API: LLM__PRIMARY__APIKEY = Llm:Primary:ApiKey.
# No definas aquí DATABASE__*: docker-compose.yml ya se las pasa a la API a partir de POSTGRES_*.
# Si falta una opción obligatoria o no es válida, la API no arranca y el log dice cuál (nunca su valor).

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=lecturafacil
POSTGRES_USER=lecturafacil
# Contraseña de la base de datos. Pon una larga y aleatoria.
POSTGRES_PASSWORD=cambia-esto

# Puerto local del frontend (solo escucha en 127.0.0.1).
WEB_PORT=8080

# ---------------------------------------------------------------------------
# Proveedor de IA principal (obligatorio)
# ---------------------------------------------------------------------------
# Tipo: OpenAICompatible (Ollama, LM Studio, vLLM, llama-swap…) o AzureFoundry.
# OpenAICompatible: ENDPOINT es la URL base de la API, la que acaba en /v1.
# AzureFoundry: ENDPOINT es la URL del recurso (se añade /openai/v1) y los modelos son nombres de despliegues.
# Ejemplos para Ollama, llama-swap y Azure AI Foundry en el README, sección "Proveedores de IA".
LLM__PRIMARY__TYPE=OpenAICompatible
# Nombre que verá la persona usuaria en la interfaz.
LLM__PRIMARY__DISPLAYNAME="Servidor propio"
# URL absoluta https, sin credenciales. Se admite http solo hacia localhost o una IP privada
# (10.x, 172.16-31.x, 192.168.x, fc00::/7), nunca hacia un nombre: el DNS podría resolverlo a una IP pública.
# Ojo: dentro de Docker, localhost es el propio contenedor de la API; pon la IP privada de la máquina
# donde corre tu proveedor o una URL https.
LLM__PRIMARY__ENDPOINT=http://localhost:11434/v1
# Clave de la API. Obligatoria; si tu servidor local no usa clave, pon cualquier texto.
LLM__PRIMARY__APIKEY=cambia-esto
# Modelo (o despliegue, en Azure) para adaptar el texto y para verificar el significado.
# El verificador debe ser de otra familia de modelos que el adaptador (docs/adr/0002-verificador-de-otra-familia.md).
LLM__PRIMARY__ADAPTERMODEL=nombre-del-modelo-adaptador
LLM__PRIMARY__VERIFIERMODEL=nombre-del-modelo-verificador
# Temperatura (0 – 2). Opcional; 0 por defecto. Súbela solo si tu modelo no admite 0.
# LLM__PRIMARY__TEMPERATURE=0

# ---------------------------------------------------------------------------
# Proveedor de respaldo (opcional, deshabilitado por defecto)
# ---------------------------------------------------------------------------
# Con false, ningún documento sale del proveedor principal y el resto de opciones del respaldo no se exigen.
LLM__FALLBACK__ENABLED=false
# Si lo habilitas, descomenta y rellena todas estas:
# LLM__FALLBACK__TYPE=AzureFoundry
# LLM__FALLBACK__DISPLAYNAME=Nube
# URL del recurso de Azure AI Foundry: https://<tu-recurso>.services.ai.azure.com/ o https://<tu-recurso>.openai.azure.com/
# LLM__FALLBACK__ENDPOINT=https://tu-recurso.example.com/
# LLM__FALLBACK__APIKEY=cambia-esto
# LLM__FALLBACK__ADAPTERMODEL=nombre-del-despliegue-adaptador
# LLM__FALLBACK__VERIFIERMODEL=nombre-del-despliegue-verificador
# LLM__FALLBACK__TEMPERATURE=0

# ---------------------------------------------------------------------------
# Resiliencia del proveedor principal (opcional; los valores comentados son los de por defecto)
# ---------------------------------------------------------------------------
# Reintentos ante un error transitorio del principal (0 – 3). El respaldo no se reintenta.
# LLM__RESILIENCE__MAXRETRYATTEMPTS=1
# Espera antes de reintentar, en milisegundos (100 – 10000).
# LLM__RESILIENCE__RETRYDELAYMILLISECONDS=500
# Circuit breaker: se abre si fallan esta proporción de llamadas (0.1 – 1) en la ventana de muestreo,
# con un mínimo de llamadas en esa ventana (2 – 100).
# LLM__RESILIENCE__FAILURERATIO=0.5
# LLM__RESILIENCE__MINIMUMTHROUGHPUT=6
# Ventana de muestreo, en segundos (1 – 600).
# LLM__RESILIENCE__SAMPLINGDURATIONSECONDS=60
# Tiempo que el circuito queda abierto antes de dejar pasar una petición de prueba, en segundos (1 – 3600).
# LLM__RESILIENCE__BREAKDURATIONSECONDS=30
# Comprobación periódica de los proveedores con una petición mínima, sin ningún documento.
# Con un respaldo de pago, cada comprobación consume unos pocos tokens.
# LLM__RESILIENCE__HEALTHCHECKENABLED=true
# Cada cuántos segundos (5 – 3600).
# LLM__RESILIENCE__HEALTHCHECKINTERVALSECONDS=30

# ---------------------------------------------------------------------------
# Límites (opcionales; los valores comentados son los de por defecto)
# ---------------------------------------------------------------------------
# Tamaño máximo de fichero en bytes (1 KB – 50 MB).
# LIMITS__MAXFILESIZEBYTES=5242880
# Caracteres máximos del texto de entrada (100 – 200000).
# LIMITS__MAXCHARACTERS=20000
# Caracteres mínimos del texto de entrada (1 – 100).
# LIMITS__MINCHARACTERS=50
# Páginas máximas de un PDF (1 – 2000). Protege frente a PDFs que agotan CPU o memoria.
# LIMITS__MAXPDFPAGES=100
# Tiempo máximo para extraer el texto de un PDF, en segundos (1 – 120).
# LIMITS__PDFEXTRACTIONTIMEOUTSECONDS=15
# PDFs que se leen a la vez como máximo (1 – 64). Los demás esperan; si no hay hueco a tiempo, 503.
# LIMITS__MAXCONCURRENTPDFEXTRACTIONS=2
# Palabras por frase a partir de las que se avisa (5 – 50).
# LIMITS__MAXWORDSPERSENTENCE=15
# Conectores por frase ("cuyo", "siempre que"…) a partir de los que se avisa de que une varias ideas (1 – 10).
# LIMITS__MAXCONNECTORSPERSENTENCE=1
# Palabras como mucho del título del documento y de cada sección de la adaptación (3 – 20).
# LIMITS__MAXWORDSPERHEADING=8
# Hallazgos de pautas que se guardan como máximo por documento (10 – 5000).
# LIMITS__MAXFINDINGSPERDOCUMENT=500
# Tokens máximos de cada respuesta del modelo (256 – 32768).
# LIMITS__MAXOUTPUTTOKENS=4096
# Tiempo máximo de cada llamada al modelo, en segundos (5 – 600). Incluye los reintentos.
# LIMITS__LLMTIMEOUTSECONDS=120
# Caracteres máximos de cada parte de un texto largo que se adapta por separado (500 – 200000).
# Debe caber en el contexto del modelo adaptador junto con el prompt y la respuesta.
# LIMITS__MAXCHARACTERSPERADAPTATIONCHUNK=6000
# Partes como máximo en que se divide un documento para adaptarlo (1 – 100). Acota las llamadas al modelo.
# LIMITS__MAXADAPTATIONCHUNKSPERDOCUMENT=10
# Nuevas adaptaciones que se piden como mucho si la adaptación incumple pautas graves (0 – 3). 0 lo desactiva.
# Cada una vuelve a adaptar el documento entero y se guarda la mejor versión.
# LIMITS__MAXADAPTATIONRETRIES=1
# Documentos que se aceptan por minuto en total en POST /api/documents (1 – 1000). Cada uno llama al modelo.
# LIMITS__DOCUMENTSUBMISSIONSPERMINUTE=10
# Documentos que se adaptan a la vez (1 – 16). 1 si el servidor del modelo atiende una petición cada vez.
# LIMITS__ADAPTATIONCONCURRENCY=1
# Cada cuánto se comprueba el estado de un documento para enviar el progreso por SSE, en milisegundos (100 – 60000).
# LIMITS__DOCUMENTEVENTSPOLLMILLISECONDS=1000
# Tiempo máximo de una conexión SSE de progreso, en segundos (10 – 3600).
# LIMITS__DOCUMENTEVENTSMAXSECONDS=600
# Documentos que muestra como mucho la lista "Mis documentos" (los más recientes) (10 – 1000).
# LIMITS__MAXDOCUMENTSPERLIST=100
# Caracteres como mucho de una adaptación editada a mano: título, secciones y glosario (1000 – 400000).
# LIMITS__MAXEDITEDCHARACTERS=40000
# Exportaciones (DOCX, PDF, Markdown o texto) por minuto, en total (1 – 1000).
# LIMITS__EXPORTSPERMINUTE=30

# ---------------------------------------------------------------------------
# Exportación a DOCX y PDF (opcional)
# ---------------------------------------------------------------------------
# Maquetación de lectura fácil. Los mínimos son 14 pt de letra e interlineado 1,5.
# Tamaño de la letra del texto y del pie, en puntos (14 – 28).
# EXPORT__FONTSIZEPOINTS=14
# Tamaño del título del documento, en puntos (14 – 48).
# EXPORT__TITLEFONTSIZEPOINTS=22
# Tamaño de las preguntas de cada sección y del título del glosario, en puntos (14 – 36).
# EXPORT__HEADINGFONTSIZEPOINTS=18
# Interlineado, en múltiplos de línea (1.5 – 3.0).
# EXPORT__LINESPACING=1.5
# Márgenes de la página A4, en centímetros (1.5 – 5.0).
# EXPORT__MARGINCENTIMETERS=2.5
# Fuente sin serifa del DOCX (el DOCX no lleva la fuente dentro). El PDF siempre usa Atkinson Hyperlegible, incluida.
# EXPORT__DOCXFONTFAMILY=Arial

# ---------------------------------------------------------------------------
# Interfaz (opcional)
# ---------------------------------------------------------------------------
# Aviso que se muestra en la interfaz (máximo 500 caracteres). Vacío = sin aviso.
UI__NOTICE=
