# Configuración de un servidor público (docs/despliegue.md). En el servidor:
#   cp deploy/.env.prod.example deploy/.env && chmod 600 deploy/.env
# y cambia todos los valores "cambia-esto". deploy/.env nunca se sube al repositorio.
# Aquí solo está lo que conviene revisar en producción; el resto de opciones, con sus rangos, en deploy/.env.example.
# Genera cada contraseña aparte, por ejemplo con: openssl rand -base64 32

# ---------------------------------------------------------------------------
# PostgreSQL: tres roles con contraseñas distintas. Se crean al crear el volumen; después no se cambian desde aquí.
# ---------------------------------------------------------------------------
POSTGRES_DB=lecturafacil
# Superusuario: solo inicializa la base y hace los backups.
POSTGRES_USER=lecturafacil
POSTGRES_PASSWORD=cambia-esto
# Propietario del esquema: solo el servicio "migrate".
POSTGRES_OWNER_USER=lecturafacil_owner
POSTGRES_OWNER_PASSWORD=cambia-esto
# El de la API: solo lee y escribe filas.
POSTGRES_APP_USER=lecturafacil_app
POSTGRES_APP_PASSWORD=cambia-esto

# ---------------------------------------------------------------------------
# Red con el proxy inverso (deploy/docker-compose.prod.yml)
# ---------------------------------------------------------------------------
# Red de Docker que la web comparte con tu proxy. Créala antes: docker network create lf-public
PUBLIC_NETWORK=lf-public
# Nombre con el que el proxy llega a la web, en el puerto 8080: http://lectura-facil-web:8080
WEB_HOSTNAME=lectura-facil-web
# Etiqueta de las imágenes que se construyen; úsala para volver a la anterior si una actualización falla.
# Con el despliegue automático la pone deploy/scripts/deploy.sh (el SHA del commit) y esta solo cuenta a mano.
# También es la versión de /health (X-App-Version) y de Sentry mientras OBSERVABILITY__RELEASE esté vacía.
IMAGE_TAG=local
# Despliegue automático (docs/despliegue.md, paso 9): el registro de donde se descargan las imágenes, con la barra
# final, por ejemplo ghcr.io/<propietario-en-minúsculas>/. Vacío = se usan las imágenes construidas en el servidor.
IMAGE_REGISTRY=

# ---------------------------------------------------------------------------
# Proveedor de IA principal (obligatorio). Detalles y ejemplos en el README, "Proveedores de IA".
# ---------------------------------------------------------------------------
LLM__PRIMARY__TYPE=OpenAICompatible
LLM__PRIMARY__DISPLAYNAME="Servidor propio"
# Dentro de Docker, localhost es el contenedor de la API: usa una URL https o la IP privada del servidor de modelos
# (también la de una VPN en 100.64.0.0/10, por ejemplo http://100.x.y.z:<puerto>/v1; ver docs/despliegue.md).
# http solo se admite hacia una IP privada, nunca hacia un nombre.
LLM__PRIMARY__ENDPOINT=https://modelos.example.com/v1
LLM__PRIMARY__APIKEY=cambia-esto
LLM__PRIMARY__ADAPTERMODEL=nombre-del-modelo-adaptador
LLM__PRIMARY__VERIFIERMODEL=nombre-del-modelo-verificador
# LLM__PRIMARY__DISABLETHINKING=true

# Respaldo opcional. Si es false, ningún documento sale del proveedor principal.
LLM__FALLBACK__ENABLED=false
# LLM__FALLBACK__TYPE=AzureFoundry
# LLM__FALLBACK__DISPLAYNAME=Nube
# LLM__FALLBACK__ENDPOINT=https://tu-recurso.example.com/
# LLM__FALLBACK__APIKEY=cambia-esto
# LLM__FALLBACK__ADAPTERMODEL=nombre-del-despliegue-adaptador
# LLM__FALLBACK__VERIFIERMODEL=nombre-del-despliegue-verificador

# ---------------------------------------------------------------------------
# Límites para una demo pública: documentos cortos que se adaptan en pocos minutos y menos llamadas por persona.
# Llamadas al modelo por documento, como mucho: partes × (1 + reintentos) + partes (aquí, 6 × 2 + 6 = 18).
# Sin estas líneas se usan los valores por defecto (150 000 caracteres y 30 partes).
# ---------------------------------------------------------------------------
# LIMITS__MAXCHARACTERS=30000
# LIMITS__MAXADAPTATIONCHUNKSPERDOCUMENT=6
# LIMITS__MAXPDFPAGES=20
# LIMITS__ADAPTATIONSPERHOUR=5

# ---------------------------------------------------------------------------
# Usuario de prueba (opcional): se crea al arrancar si no existe. Vacío, no se crea.
# ---------------------------------------------------------------------------
SEED__TESTUSER__EMAIL=
SEED__TESTUSER__PASSWORD=

# ---------------------------------------------------------------------------
# Protección frente a bots en el inicio de sesión (Cloudflare Turnstile, opcional).
# ---------------------------------------------------------------------------
TURNSTILE__ENABLED=false
TURNSTILE__SITEKEY=
TURNSTILE__SECRETKEY=

# Aviso visible en la interfaz, por ejemplo: "Demostración: no subas datos personales." (máx. 500 caracteres).
UI__NOTICE=

# ---------------------------------------------------------------------------
# Observabilidad (opcional). Sin DSN, Sentry no se usa.
# ---------------------------------------------------------------------------
OBSERVABILITY__SENTRYDSN=
OBSERVABILITY__FRONTENDSENTRYDSN=
# OBSERVABILITY__ENVIRONMENT=production
